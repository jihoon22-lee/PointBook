# 관리자 계정 (scripts/init_db.py 에서 사용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 세션 서명 키 (임의의 긴 문자열)
SECRET_KEY=dev-secret-change-me

# 보안 강화: 기본 시크릿/비밀번호 사용 시 서버 시작을 거부 (운영에서는 true 권장)
# ENFORCE_SECURE_DEFAULTS=true

# 로그인 브루트포스 방지 (실패 허용 횟수 / 잠금 시간(초))
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300

# 요청서 이미지 업로드 최대 크기 (MB)
# MAX_UPLOAD_MB=10

# 세션 쿠키 옵션 (HTTPS 전환 시 COOKIE_SECURE=true)
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# AI 프로바이더 (mock | gemini | openai) — 키 없으면 mock 사용
AI_PROVIDER=mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=

# Mock 프로바이더가 반환할 요청서 테이블 (JSON 배열, 선택 — 없으면 기본 샘플)
# MOCK_TABLE_JSON=[{"personal_no":"101","name":"김소방","team":"1팀","grade":"소방경","amount":50000}]
