# 관리자 계정 (scripts/init_db.py 에서 사용)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# 세션 서명 키 (임의의 긴 문자열)
SECRET_KEY=dev-secret-change-me

# 운영은 production: 기본/빈 SECRET_KEY·기본 DB 관리자 암호·Mock 제공자를 거부
APP_ENV=development

# development에서도 기본 시크릿/DB 암호 차단을 적용할 때
# ENFORCE_SECURE_DEFAULTS=true

# 로그인 브루트포스 방지 (실패 허용 횟수 / 잠금 시간(초))
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300

# 요청서 이미지 업로드 최대 크기 (MB)
# MAX_UPLOAD_MB=10

# 세션 쿠키 옵션 (HTTPS 전환 시 COOKIE_SECURE=true)
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=false

# DB 파일 경로 (기본 data/pointbook.db)
# DATABASE_PATH=data/pointbook.db

# 월간 확정 전 자동 백업 보관 개수 (data/backups/)
# BACKUP_KEEP=30

# AI 프로바이더 (mock | gemini). 운영은 gemini만 허용, 키/제공자 오류를 Mock으로 바꾸지 않음
AI_PROVIDER=mock
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Mock 프로바이더가 반환할 요청서 테이블 (JSON 배열, 선택 — 없으면 기본 샘플)
# MOCK_TABLE_JSON=[{"point_no":"00000001","account_type":"person","personal_no":"101","name":"김소방","team":"1팀","grade":"소방경","amount":50000}]

# AI 실행·응답 한도 (인식 중에도 조회/로그인 응답 유지)
# AI_MAX_CONCURRENCY=2
# AI_TIMEOUT_SECONDS=90
# AI_MAX_RESPONSE_BYTES=2000000

# 프록시가 있을 때 신뢰할 실제 접속 IP만 지정. 빈 값은 전달 헤더 미신뢰
# FORWARDED_ALLOW_IPS=

# 호스트 데이터/백업 위치: Compose와 운영 스크립트가 같은 선택 env 파일을 해석
# POINTBOOK_DATA_DIR=./data
# POINTBOOK_BACKUP_DIR=./data/backups
# POINTBOOK_PORT=8002

# 서버 초안: 마지막 저장부터 보관 일수 / 진행 중 최대 개수
# DRAFT_KEEP_DAYS=30
# DRAFT_MAX_ACTIVE=20
